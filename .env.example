# Entorno: development o production
FLASK_ENV=development

# Genere un valor aleatorio de al menos 32 bytes.
FLASK_SECRET_KEY=

# Cliente OAuth 2.0 de tipo "Aplicación web" en Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Desarrollo local habitual:
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
GOOGLE_WORKSPACE_ALLOWED_DOMAIN=lugohermanos.com

# Integración de visitas Google Sheets/AppSheet (cuenta de servicio separada).
GOOGLE_VISITS_SPREADSHEET_ID=
GOOGLE_VISITS_WORKSHEET_NAME=
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_PATH=

# Flujo RFQ/Gmail (autorización Gmail separada del login y de Sheets).
RFQ_DEFAULT_SENDER_EMAIL=ricardo.lugo@lugohermanos.com
RFQ_DEFAULT_RESPONSIBLE_EMAIL=jeanp.florez@lugohermanos.com
RFQ_ALWAYS_CC_EMAIL=ricardo.lugo@lugohermanos.com
GOOGLE_GMAIL_TOKEN_JSON=

# Ask · Analista Comercial
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Railway: mount a persistent volume at this directory.
APP_DATA_DIR=/data
